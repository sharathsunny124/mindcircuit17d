<!DOCTYPE html>
<html>
<head>
    <title>Allu Arjun UI</title>
    <style>
        body {
            background-image: url('https://m.media-amazon.com/images/M/MV5BMjA4YjYyYzItZjYyZS00YjYyLTkzYjItZjYyYjYyYzItZjYyYjYyYzItZjYyYjYyYzItZjYyYjYyYzIt.jpg');
            background-size: cover;       /* Fill the entire page */
            background-repeat: no-repeat; /* Prevent tiling */
            background-position: center;  /* Center the image */
            color: white;                 /* Text color for contrast */
            text-align: center;
            font-family: Arial, sans-serif;
        }
        .overlay {
            background-color: rgba(0,0,0,0.5); /* Semi-transparent layer for readability */
            padding: 50px;
            border-radius: 10px;
            display: inline-block;
            margin-top: 100px;
        }
    </style>
</head>
<body>
    <div class="overlay">
        <h1>Welcome to Jenkins Deployment!</h1>
        <p>This page is served from Tomcat after Jenkins build & deploy.</p>
    </div>
</body>
</html>
